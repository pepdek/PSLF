rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // the first Google account to sign in claims settings/owner; nobody can change it afterwards
    function isOwner() {
      return request.auth != null
        && get(/databases/$(db)/documents/settings/owner).data.uid == request.auth.uid;
    }

    match /settings/owner {
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }

    match /settings/hq {
      allow read, write: if isOwner();
    }

    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['email','createdAt','source','tier'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() < 255
        && request.resource.data.source is string
        && request.resource.data.tier is string
        && request.resource.data.createdAt == request.time;
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
